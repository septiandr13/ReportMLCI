          <Textbox Name="Textbox1">
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Label>Deskripsi</Label>
                    <Value>="&lt;j&gt;&lt;b&gt;&lt;u&gt;Daftar Perincian Pembiayaan Investasi/Multiguna untuk Pembelian Dengan Pembayaran Secara Angsuran&lt;/u&gt;&lt;/b&gt; ini (selanjutnya disebut &lt;b&gt;""Daftar Perincian Pembiayaan""&lt;/b&gt;) merupakan perincian dan ketentuan pembiayaan yang diberikan oleh KREDITUR kepada DEBITUR berdasarkan PERJANJIAN, dan &lt;b&gt;merupakan bagian yang tidak terpisahkan dari PERJANJIAN.&lt;/b&gt;"</Value>
                    <MarkupType>HTML</MarkupType>
                    <Style>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
