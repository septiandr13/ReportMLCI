                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															Debitur telah membayar Uang Muka sebagaimana disebutkan dalam Pasal 3 PERJANJIAN ini dan Butir 2(b) Daftar Perincian Pembiayaan pada Lampiran II PERJANJIAN ini.
															&lt;/div&gt;"</Value>
