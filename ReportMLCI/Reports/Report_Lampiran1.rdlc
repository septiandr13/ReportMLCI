                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="P21T2">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															Angsuran Pembiayaan dan Jangka Waktu Pembiayaan sebagaimana dimaksud Pasal 3 PERJANJIAN ini dan Butir 2(c) dan (d) Daftar Perincian Pembiayaan pada Lampiran II PERJANJIAN ini akan berlaku sejak tanggal dicairkannya Fasilitas Pembiayaan.
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
