                      <TablixCells>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="P21N2">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>2.3</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
