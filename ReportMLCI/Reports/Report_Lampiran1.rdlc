                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>d.</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>30pt</PaddingLeft>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="SdT">
                              <CanGrow>true</CanGrow>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															Telah diterimanya asli semua dokumen kepemilikan atas BARANG oleh KREDITUR, termasuk namun tidak terbatas kepada faktur (invoice), kwitansi asli dari PENJUAL, [atau asli BPKB (dalam hal pembiayaan untuk kendaraan bekas pakai)].
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
