                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															PARA PIHAK telah sepakat untuk tunduk dan patuh kepada seluruh syarat dan ketentuan PERJANJIAN sebagaimana diatur pada Syarat dan Ketentuan Pembiayaan terlampir dalam Lampiran I PERJANJIAN ini.
															&lt;/div&gt;"</Value>
