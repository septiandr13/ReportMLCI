                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="ScT2">
                              <CanGrow>true</CanGrow>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															Telah dibuat dan ditandatangani Berita Acara Penyerahan BARANG yang menyatakan bahwa DEBITUR telah menerima dan melakukan pemeriksaan atas BARANG yang telah diserahkan oleh KREDITUR atau PENJUAL dalam kondisi lengkap, baik, layak dipakai, dan memuaskan serta sesuai dengan PERJANJIAN ini.
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
                    </TablixRow>
                    <TablixRow>
                      <Height>0.82117cm</Height>
                      <TablixCells>
                        <TablixCell>
