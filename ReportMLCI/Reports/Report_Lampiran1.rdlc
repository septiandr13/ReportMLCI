                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															DEBITUR telah membayar biaya-biaya sebagaimana disebutkan dalam Butir 3 Daftar Perincian Pembiayaan pada Lampiran II PERJANJIAN ini.
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
