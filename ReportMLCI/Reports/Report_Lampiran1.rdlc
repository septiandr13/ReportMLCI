                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															MITSUI LEASING CAPITAL INDONESIA, PT., berkedudukan hukum di JAKARTA PUSAT, dan beralamat kantor cabang di &lt;u&gt;"
															+ First(Fields!KantorCabang.Value) +
															"&lt;/u&gt;, perbuatan hukum ini diwakili secara sah oleh Bapak "
															+ First(Fields!NamaKepalaCabang.Value) +
															", dalam kedudukannya sebagai KEPALA CABANG berhak bertindak untuk dan atas nama MITSUI LEASING CAPITAL INDONESIA, PT., selanjutnya disebut ""KREDITUR"", dengan;
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
