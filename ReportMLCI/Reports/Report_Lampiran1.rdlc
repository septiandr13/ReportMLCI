                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>JAMINAN FASILITAS PEMBIAYAAN</Value>
                        <Style>
                          <FontFamily>Times New Roman</FontFamily>
                          <FontSize>7pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <TextDecoration>Underline</TextDecoration>
                        </Style>
                      </TextRun>
                    </TextRuns>
