              <Textbox Name="Pasal4Hdr">
                <CanGrow>true</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>PASAL 4</Value>
                        <Style>
