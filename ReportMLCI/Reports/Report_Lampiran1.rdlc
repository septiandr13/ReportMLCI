              </Tablix>
              <Textbox Name="Pasal3Hdr">
                <CanGrow>true</CanGrow>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>PASAL 3</Value>
                        <Style>
                          <FontFamily>Times New Roman</FontFamily>
                          <FontSize>7pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>UANG MUKA, ANGSURAN PEMBIAYAAN DAN JANGKA WAKTU PEMBIAYAAN</Value>
                        <Style>
                          <FontFamily>Times New Roman</FontFamily>
                          <FontSize>7pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <TextDecoration>Underline</TextDecoration>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Center</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <Top>17.15722cm</Top>
                <Height>0.65cm</Height>
                <Width>17cm</Width>
                <ZIndex>11</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                </Style>
              </Textbox>
              <Tablix Name="TblPasal4">
                <TablixBody>
                  <TablixColumns>
                    <TablixColumn>
                      <Width>1cm</Width>
                    </TablixColumn>
                    <TablixColumn>
                      <Width>16cm</Width>
                    </TablixColumn>
                  </TablixColumns>
                  <TablixRows>
                    <TablixRow>
                      <Height>1.6825cm</Height>
                      <TablixCells>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="P21N3">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>3.1</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="P21T3">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															Setelah dicairkannya Fasilitas Pembiayaan oleh KREDITUR, DEBITUR dengan ini mengakui telah berhutang kepada KREDITUR sebesar jumlah keseluruhan pembiayaan yang diberikan oleh KREDITUR kepada DEBITUR yang cukup dibuktikan dengan Kuitansi atau PERJANJIAN ini sebagai bukti tanda penerimaan yang sah atas seluruh jumlah Fasilitas Pembiayaan ditambah dengan bunga dan biaya-biaya lainnya yang wajib dibayar oleh DEBITUR kepada KREDITUR sebagaimana disebutkan dalam butir 2 (e) Daftar Perincian Pembiayaan pada Lampiran II PERJANJIAN ini dan DEBITUR dengan ini wajib membayarkan Angsuran Pembiayaan setiap bulannya dengan metode pembayaran via transfer bank/metode pembayaran giro.
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
                    </TablixRow>
                    <TablixRow>
                      <Height>1.14783cm</Height>
                      <TablixCells>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="P22N2">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>3.2</Value>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="P22T2">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>="&lt;J&gt;&lt;div style='margin:0; padding:0;'&gt;
															Besarnya Angsuran Pembiayaan setiap bulannya yang wajib dibayarkan oleh DEBITUR kepada KREDITUR yaitu sejumlah Rp.&lt;u&gt;"
															+ First(Fields!BesaranAngsuran.Value) +
															"&lt;/u&gt; dengan Jangka Waktu Pembiayaan selama &lt;u&gt;"
															+ First(Fields!JangkaWaktu.Value) +
															"&lt;/u&gt; bulan secara in advance/dimuka. KREDITUR akan menerbitkan kuitansi pembayaran angsuran bermaterai berdasarkan permintaan dari DEBITUR setelah KREDITUR menerima dana angsuran pembiayaan.
															&lt;/div&gt;"</Value>
                                      <MarkupType>HTML</MarkupType>
                                      <Style>
                                        <FontFamily>Times New Roman</FontFamily>
                                        <FontSize>7pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <LineHeight>14pt</LineHeight>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                      </TablixCells>
