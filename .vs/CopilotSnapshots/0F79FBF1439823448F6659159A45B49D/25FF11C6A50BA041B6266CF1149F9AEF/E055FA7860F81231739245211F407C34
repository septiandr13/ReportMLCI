        // ==================== Helper Method untuk CLI ====================
        /// <summary>
        /// Jalankan dengan command line arguments
        /// Usage: RdlcProcessorExample process [filename]
        ///        RdlcProcessorExample detect [filename]
        ///        RdlcProcessorExample all
        /// </summary>
        public static void ExecuteCommand(string[] args)
        {
            try
            {
                if (args.Length == 0)
                {
                    // Default: Process all RDLC files
                    Console.WriteLine("No arguments provided. Processing all RDLC files...");
                    Example3_ProcessAllFiles();
                }
                else
                {
                    string command = args[0].ToLower();

                    switch (command)
                    {
                        case "process":
                            if (args.Length > 1)
                            {
                                var tool = new RdlcProcessorTool();
                                tool.ProcessSingleFile(args[1]);
                            }
                            else
                            {
                                Example3_ProcessAllFiles();
                            }
                            break;

                        case "detect":
                            if (args.Length > 1)
                            {
                                var tool = new RdlcProcessorTool();
                                tool.DetectOnly(args[1]);
                            }
                            else
                            {
                                Example4_DetectAllFiles();
                            }
                            break;

                        case "extract":
                            if (args.Length > 1)
                            {
                                var tool = new RdlcProcessorTool();
                                tool.ExtractJustifyContent(args[1]);
                            }
                            break;

                        case "all":
                            Example3_ProcessAllFiles();
                            break;

                        case "examples":
                            RunAllExamples();
                            break;

                        default:
                            Console.WriteLine("Unknown command: " + command);
                            PrintUsage();
                            break;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error: {ex.Message}");
            }
        }

        private static void PrintUsage()
        {
            Console.WriteLine("\nUsage:");
            Console.WriteLine("  RdlcProcessorExample.ExecuteCommand(new[] { \"process\", \"Report_Lampiran2.rdlc\" });");
            Console.WriteLine("  RdlcProcessorExample.ExecuteCommand(new[] { \"detect\", \"Report_Lampiran2.rdlc\" });");
            Console.WriteLine("  RdlcProcessorExample.ExecuteCommand(new[] { \"extract\", \"Report_Lampiran2.rdlc\" });");
            Console.WriteLine("  RdlcProcessorExample.ExecuteCommand(new[] { \"all\" });");
            Console.WriteLine("  RdlcProcessorExample.ExecuteCommand(new[] { \"examples\" });");
        }
    }
