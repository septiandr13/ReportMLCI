        // ==================== EXAMPLE 7: Count Tags ====================
        public static void Example7_CountTags()
        {
            Console.WriteLine("\n╔════════════════════════════════════════════╗");
            Console.WriteLine("║   Example 7: Count Justify Tags            ║");
            Console.WriteLine("╚════════════════════════════════════════════╝\n");

            var tool = new RdlcProcessorTool();
            string[] rdlcFiles = tool.GetAllRdlcFiles();

            Console.WriteLine($"Total RDLC files: {rdlcFiles.Length}\n");

            foreach (var file in rdlcFiles)
            {
                string fileName = Path.GetFileName(file);
                string content = File.ReadAllText(file);
                int count = RdlcJustifyTagProcessor.CountJustifyTags(content);

                if (count > 0)
                {
                    Console.WriteLine($"  ✓ {fileName}: {count} <j> tags");
                }
            }
        }

        // ==================== EXAMPLE 8: Batch Processing Report ====================
        public static void Example8_BatchProcessingReport()
        {
            Console.WriteLine("\n╔════════════════════════════════════════════╗");
            Console.WriteLine("║   Example 8: Batch Processing Report       ║");
            Console.WriteLine("╚════════════════════════════════════════════╝\n");

            var tool = new RdlcProcessorTool();
            string[] rdlcFiles = tool.GetAllRdlcFiles();

            Console.WriteLine($"Scanning {rdlcFiles.Length} RDLC files...\n");

            int totalTags = 0;
            int filesWithTags = 0;

            foreach (var file in rdlcFiles)
            {
                string fileName = Path.GetFileName(file);
                string content = File.ReadAllText(file);
                int count = RdlcJustifyTagProcessor.CountJustifyTags(content);

                if (count > 0)
                {
                    Console.WriteLine($"  ✓ {fileName}: {count} tag(s) - Ready to process");
                    totalTags += count;
                    filesWithTags++;
                }
                else
                {
                    Console.WriteLine($"  ○ {fileName}: No tags");
                }
            }

            Console.WriteLine($"\n--- Summary ---");
            Console.WriteLine($"  Files with tags: {filesWithTags}/{rdlcFiles.Length}");
            Console.WriteLine($"  Total tags: {totalTags}");
            Console.WriteLine($"  Ready to convert: {(totalTags > 0 ? "YES" : "NO")}");
        }

