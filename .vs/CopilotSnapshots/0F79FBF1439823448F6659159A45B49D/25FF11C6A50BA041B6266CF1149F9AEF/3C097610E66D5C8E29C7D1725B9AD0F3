    public partial class Form1 : Form
    {
        private ReportProcessorController _reportProcessor;
        private RdlcProcessorTool _rdlcProcessorTool;

        public Form1()
        {
            InitializeComponent();
            this.Load += Form1_Load;
            comboBox1.SelectedIndexChanged += ComboBox1_SelectedItemChanged;
            _reportProcessor = new ReportProcessorController();

            // Initialize RDLC processor tool
            string reportsPath = Path.Combine(Application.StartupPath, "Reports");
            _rdlcProcessorTool = new RdlcProcessorTool(reportsPath);
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // Auto-process RDLC files dengan tag <j> pada form load
            AutoProcessRdlcFiles();

            // Isi pilihan report
            comboBox1.Items.Add("Report 1");
            comboBox1.Items.Add("Report Lampiran 2");
        }

        private void AutoProcessRdlcFiles()
        {
            try
            {
                string reportsPath = Path.Combine(Application.StartupPath, "Reports");
                if (!Directory.Exists(reportsPath))
                    return;

                string[] rdlcFiles = Directory.GetFiles(reportsPath, "*.rdlc");

                foreach (var file in rdlcFiles)
                {
                    string content = File.ReadAllText(file);
                    int tagCount = RdlcJustifyTagProcessor.CountJustifyTags(content);

                    if (tagCount > 0)
                    {
                        // Auto-process file
                        string processed = RdlcJustifyTagProcessor.ProcessRdlcContent(content);
                        RdlcJustifyTagProcessor.SaveProcessedRdlcFile(file, processed, backupOriginal: true);
                    }
                }
            }
            catch (Exception ex)
            {
                // Silently fail - don't interrupt form loading
                System.Diagnostics.Debug.WriteLine($"RDLC auto-processing error: {ex.Message}");
            }
        }

        private void ComboBox1_SelectedIndexChanged(object sender, EventArgs e)
        {
            LoadReport(comboBox1.SelectedItem.ToString());
        }

        private void LoadReport(string reportName)
