namespace ReportMLCI
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
            this.Load += Form1_Load;
            comboBox1.SelectedIndexChanged += ComboBox1_SelectedIndexChanged;
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            // Isi pilihan report
            comboBox1.Items.Add("Report 1");
            comboBox1.Items.Add("Report Lampiran 2");

        }

        private void ComboBox1_SelectedIndexChanged(object sender, EventArgs e)
        {
            LoadReport(comboBox1.SelectedItem.ToString());
        }

        private void LoadReport(string reportName)
        {
            string fileName = "";

            switch (reportName)
            {
                case "Report 1":
                    fileName = "Report1.rdlc";
                    break;
                case "Report Lampiran 2":
                    fileName = "Report_Lampiran2.rdlc";
                    break;
            }

            string reportPath = Path.Combine(Application.StartupPath, "Reports", fileName);

            if (!File.Exists(reportPath))
            {
                MessageBox.Show("File tidak ditemukan:\n" + reportPath);
                return;
            }

            reportViewer1.LocalReport.ReportPath = reportPath;

            // Determine which data source to use based on report name
            if (reportName == "Report Lampiran 2")
            {
                // Dummy data for Report_Lampiran2
                var dataLampiran2 = new List<DataLampiran2>
                {
                    new DataLampiran2
                    {
                        Np = "1512345678",
                        NamaPenjual = "PT MITSUI LEASING CAPITAL INDONESIA",
                        AlamatPenjual = "JL. GATOT SUBROTO KAV. 42, JAKARTA"
                    }
                };

                reportViewer1.LocalReport.DataSources.Clear();
                reportViewer1.LocalReport.DataSources.Add(
                    new Microsoft.Reporting.WinForms.ReportDataSource("DataSet1", dataLampiran2)
                );
            }
            else
            {
                // Dummy data for Report 1
                var data = new List<Produk>
                {
                    new Produk { ID = 1, Nama = "Produk A", Jumlah = 10 },
                    new Produk { ID = 2, Nama = "Produk B", Jumlah = 20 }
                };

                reportViewer1.LocalReport.DataSources.Clear();
                reportViewer1.LocalReport.DataSources.Add(
                    new Microsoft.Reporting.WinForms.ReportDataSource("DataSet1", data)
                );
            }

            //reportViewer1.LocalReport.EnableExternalImages = true;
            reportViewer1.RefreshReport();
        }

        public class Produk
        {
            public int ID { get; set; }
            public string Nama { get; set; }
            public int Jumlah { get; set; }
        }

        public class DataLampiran2
        {
            public string Np { get; set; }
            public string NamaPenjual { get; set; }
            public string AlamatPenjual { get; set; }
        }
    }
}